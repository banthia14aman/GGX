{
  "$schema": "https://design-tokens.org/schema.json",
  "primitive": {
    "color": {
      "ink": {
        "950": { "$value": "#0B0B10", "$type": "color" },
        "900": { "$value": "#16161D", "$type": "color" },
        "800": { "$value": "#22222B", "$type": "color" },
        "700": { "$value": "#2E2E39", "$type": "color" },
        "500": { "$value": "#5E5E6B", "$type": "color" },
        "400": { "$value": "#9A9AA8", "$type": "color" },
        "200": { "$value": "#E4E4E0", "$type": "color" },
        "100": { "$value": "#F6F6F3", "$type": "color" },
        "50": { "$value": "#F4F4F6", "$type": "color" }
      },
      "white": { "$value": "#FFFFFF", "$type": "color" },
      "volt": {
        "400": { "$value": "#D4FF3A", "$type": "color" },
        "500": { "$value": "#C2EE1F", "$type": "color" },
        "800": { "$value": "#4A6B00", "$type": "color" }
      },
      "violet": {
        "300": { "$value": "#9D86FF", "$type": "color" },
        "500": { "$value": "#6D4AFF", "$type": "color" },
        "600": { "$value": "#5B3BE8", "$type": "color" }
      },
      "green": { "400": { "$value": "#4ADE80", "$type": "color" }, "700": { "$value": "#15803D", "$type": "color" } },
      "amber": { "400": { "$value": "#FBBF24", "$type": "color" }, "700": { "$value": "#B45309", "$type": "color" } },
      "red": { "400": { "$value": "#F87171", "$type": "color" }, "600": { "$value": "#DC2626", "$type": "color" } }
    },
    "font": {
      "display": { "$value": "'Chakra Petch', system-ui, sans-serif", "$type": "fontFamily" },
      "body": { "$value": "'Inter', system-ui, -apple-system, sans-serif", "$type": "fontFamily" },
      "mono": { "$value": "'JetBrains Mono', ui-monospace, monospace", "$type": "fontFamily" }
    },
    "fontSize": {
      "xs": { "$value": "0.75rem", "$type": "dimension" },
      "sm": { "$value": "0.875rem", "$type": "dimension" },
      "base": { "$value": "1rem", "$type": "dimension" },
      "lg": { "$value": "1.125rem", "$type": "dimension" },
      "xl": { "$value": "1.375rem", "$type": "dimension" },
      "2xl": { "$value": "1.75rem", "$type": "dimension" },
      "3xl": { "$value": "2.25rem", "$type": "dimension" }
    },
    "spacing": {
      "1": { "$value": "0.25rem", "$type": "dimension" },
      "2": { "$value": "0.5rem", "$type": "dimension" },
      "3": { "$value": "0.75rem", "$type": "dimension" },
      "4": { "$value": "1rem", "$type": "dimension" },
      "6": { "$value": "1.5rem", "$type": "dimension" },
      "8": { "$value": "2rem", "$type": "dimension" },
      "12": { "$value": "3rem", "$type": "dimension" }
    },
    "radius": {
      "sm": { "$value": "4px", "$type": "dimension" },
      "md": { "$value": "8px", "$type": "dimension" },
      "lg": { "$value": "14px", "$type": "dimension" },
      "full": { "$value": "9999px", "$type": "dimension" }
    },
    "duration": {
      "fast": { "$value": "120ms", "$type": "duration" },
      "normal": { "$value": "200ms", "$type": "duration" }
    }
  },
  "semantic": {
    "color": {
      "background": { "$value": "{primitive.color.ink.100}", "$type": "color" },
      "surface": { "$value": "{primitive.color.white}", "$type": "color" },
      "surface-raised": { "$value": "{primitive.color.ink.100}", "$type": "color" },
      "foreground": { "$value": "{primitive.color.ink.950}", "$type": "color" },
      "muted-foreground": { "$value": "{primitive.color.ink.500}", "$type": "color" },
      "border": { "$value": "{primitive.color.ink.200}", "$type": "color" },
      "primary": { "$value": "{primitive.color.volt.400}", "$type": "color" },
      "primary-hover": { "$value": "{primitive.color.volt.500}", "$type": "color" },
      "primary-foreground": { "$value": "{primitive.color.ink.950}", "$type": "color" },
      "link": { "$value": "{primitive.color.volt.800}", "$type": "color" },
      "arena": { "$value": "{primitive.color.violet.500}", "$type": "color" },
      "arena-foreground": { "$value": "{primitive.color.white}", "$type": "color" },
      "arena-text": { "$value": "{primitive.color.violet.600}", "$type": "color" },
      "success": { "$value": "{primitive.color.green.700}", "$type": "color" },
      "warning": { "$value": "{primitive.color.amber.700}", "$type": "color" },
      "danger": { "$value": "{primitive.color.red.600}", "$type": "color" },
      "ring": { "$value": "{primitive.color.violet.500}", "$type": "color" }
    }
  },
  "component": {
    "button": {
      "bg": { "$value": "{semantic.color.primary}", "$type": "color" },
      "fg": { "$value": "{semantic.color.primary-foreground}", "$type": "color" },
      "hover-bg": { "$value": "{semantic.color.primary-hover}", "$type": "color" },
      "radius": { "$value": "{primitive.radius.md}", "$type": "dimension" },
      "height": { "$value": "44px", "$type": "dimension" },
      "padding-x": { "$value": "{primitive.spacing.4}", "$type": "dimension" }
    },
    "card": {
      "radius": { "$value": "{primitive.radius.lg}", "$type": "dimension" },
      "padding": { "$value": "{primitive.spacing.4}", "$type": "dimension" }
    },
    "input": {
      "height": { "$value": "44px", "$type": "dimension" },
      "radius": { "$value": "{primitive.radius.md}", "$type": "dimension" }
    },
    "chip": {
      "radius": { "$value": "{primitive.radius.full}", "$type": "dimension" }
    },
    "tabbar": {
      "height": { "$value": "64px", "$type": "dimension" }
    }
  },
  "dark": {
    "semantic": {
      "color": {
        "background": { "$value": "{primitive.color.ink.950}", "$type": "color" },
        "surface": { "$value": "{primitive.color.ink.900}", "$type": "color" },
        "surface-raised": { "$value": "{primitive.color.ink.800}", "$type": "color" },
        "foreground": { "$value": "{primitive.color.ink.50}", "$type": "color" },
        "muted-foreground": { "$value": "{primitive.color.ink.400}", "$type": "color" },
        "border": { "$value": "{primitive.color.ink.700}", "$type": "color" },
        "link": { "$value": "{primitive.color.volt.400}", "$type": "color" },
        "arena-text": { "$value": "{primitive.color.violet.300}", "$type": "color" },
        "success": { "$value": "{primitive.color.green.400}", "$type": "color" },
        "warning": { "$value": "{primitive.color.amber.400}", "$type": "color" },
        "danger": { "$value": "{primitive.color.red.400}", "$type": "color" }
      }
    }
  }
}
